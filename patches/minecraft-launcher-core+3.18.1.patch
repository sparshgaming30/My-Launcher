+// PATCHED: run async work in small concurrent batches instead of firing every
+// item at once via Promise.all(array.map(...)). MCLC's downloader uses the
+// long-deprecated 'request' package, and for modern Minecraft versions the
+// asset index alone can contain 5,000+ files -- launching all of them
+// simultaneously routinely triggers 'Client network socket disconnected
+// before secure TLS connection was established' against Mojang's servers.
+// A small batch size keeps real concurrency low and reliable.
+async function runBatched (items, worker, batchSize = 6) {
+  for (let i = 0; i < items.length; i += batchSize) {
+    const batch = items.slice(i, i + batchSize)
+    await Promise.all(batch.map(worker))
+  }
+}
